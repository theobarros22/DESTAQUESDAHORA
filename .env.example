# Configuração do Destaques da Hora. Copie para .env e ajuste (ou rode node scripts/init-env.ts, que gera o .env com chaves aleatórias).
# O front-end só recebe o endereço do site; todas as chaves ficam no back-end. Não envie o .env para o Git.

# ===== Obrigatório =====

# Endereço público do site: links gerados, RSS, imagens de compartilhamento e MCP usam este valor. Para testar na sua máquina, deixe o abaixo.
SITE_URL=http://localhost:3000

# Senha do administrador (mínimo 12 caracteres), usada para entrar em /admin.
ADMIN_PASSWORD=

# Chaves de assinatura da sessão e do proxy de imagens; coloque uma sequência aleatória em cada (por exemplo, openssl rand -hex 32).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Senha do banco quando usar Docker (o banco não expõe porta; use caracteres aleatórios também).
POSTGRES_PASSWORD=

# Modelo: qualquer API compatível com OpenAI; todas as etapas usam este por padrão. Abaixo, o exemplo do DeepSeek.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Parâmetros de requisição específicos do provedor (JSON), por exemplo para desligar o modo de raciocínio:
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# Exemplos de outros provedores:
#   Qwen      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   Zhipu     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# Ative se o modelo enxerga imagens (título e resumo da seleção consideram a imagem principal):
# LLM_VISION=true
# Desative se o serviço não aceita modo JSON (response_format):
# LLM_JSON_MODE=false
# Saída extra reservada ao raciocínio em modelos de raciocínio (pensam antes de responder; raciocínio e resposta dividem o limite de saída), somada ao limite de cada etapa; vazio equivale a 0.
# Defina quando a chamada acusar "output token limit reached (finish_reason=length)", por exemplo:
# LLM_REASONING_TOKENS=4000

# ===== Opcional: agrupamento de eventos mais preciso =====

# Busca por vetores: qualquer API /embeddings compatível com OpenAI. Funciona sem isso: o agrupamento passa a buscar candidatos por sobreposição de texto,
# mas postagens de discussão usadas só como evidência de popularidade (fontes hot_signal) quase não se ligam a eventos, e a popularidade fica baixa.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Ou preencha só a chave do Alibaba Cloud Bailian para usar o text-embedding-v4:
# DASHSCOPE_API_KEY=
# Dimensão dos vetores (com EMBEDDING_* usa a que o serviço devolver; o Bailian usa 1024 por padrão); ao mudar, os vetores antigos são recalculados:
# EMBEDDING_DIMS=

# ===== Opcional: trocar o modelo de cada etapa =====
# Por padrão, cada etapa usa o LLM_* acima. Para usar outro provedor em uma etapa, informe o nome da predefinição (exige a chave correspondente):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# Nomes das predefinições e chaves necessárias:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Atenção: com DASHSCOPE_API_KEY preenchida e sem EMBEDDING_API_KEY, o agrupamento usa automaticamente os vetores do Bailian (text-embedding-v4), cobrados à parte pelo preço do Bailian.

# ===== Opcional: serviços de coleta pagos (cobrados por requisição, com disjuntor de orçamento, ajustados em "Configurações" na administração) =====
# Contas do X (Twitter): SocialData
# SOCIALDATA_API_KEY=
# Contas do WeChat: Dajiala
# DAJIALA_KEY=
# Quando não conseguir o texto: renderização por navegador com Jina Reader
# JINA_API_KEY=

# ===== Opcional: Feishu =====
# Envio da seleção para um grupo do Feishu (só fontes T1 e T1_5): ative em "Configurações → Destinos de notificação" na administração e informe o endereço do webhook aqui.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alertas e feedback encaminhados para o grupo interno do Feishu (o feedback exige um app próprio do Feishu):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Alertas só com texto também podem ir para um robô personalizado de um grupo: com isto preenchido, os alertas vão por webhook e não usam mais o app e o ID do grupo acima (não consome a cota de chamadas do app).
# FEISHU_ALERT_WEBHOOK_URL=
# Alertas entregues primeiro ao seu próprio serviço de tratamento automático (por exemplo, um intermediário de webhook que acorda uma IA); só é usado com os dois campos preenchidos e FEISHU_INTERNAL_ENABLED=true:
# O alerta a tratar é enviado por POST para este endereço (Authorization: Bearer <KEY>, campos JSON id, type, subject, summary, detail, link); responder 200 conta como recebido, e o mesmo id pode ser reenviado;
# Alertas, recuperações e relatórios diários do sistema destinados a você vão antes por POST para /tell na raiz do mesmo host (campos JSON key, text); se não forem aceitos, seguem pelo Feishu acima. O comportamento está em "Atualização" no docs/deploy.md.
# WEBHOOK_HUB_URL=
# WEBHOOK_HUB_KEY=
# Entrar na administração com conta do Feishu (opcional, convive com a senha do administrador):
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Opcional: outros =====
# Fontes JSON da API do GitHub (api.github.com) usam este token para uma cota maior. É gratuito e basta permissão somente de leitura:
# GITHUB_TOKEN=
# Token usado por scripts externos para enviar conteúdo ao site (POST /api/ingest/items), com pelo menos 16 caracteres; vazio desativa essa interface.
# INGEST_TOKEN=
# Máximo de envios por cliente por minuto na interface de envio (padrão 10 no docker compose); pode ser 0 se um proxy reverso à frente já limita:
# INGEST_RATE_LIMIT=10
# Para coletar fontes estrangeiras por proxy (por exemplo, servidor com restrições de acesso):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# Quando o feed ou a lista de uma fonte vem de um serviço interno seu (por exemplo, um RSSHub na mesma rede Docker), liste nomes de host completos separados por vírgula (sem distinção de maiúsculas, sem curinga).
# Só esses endereços são liberados, em conexão direta e sem o proxy acima; redirecionamentos para outros hosts, textos de artigos e imagens continuam sem acesso à rede interna, e endereços link-local e de metadados de nuvem são sempre recusados:
# PRIVATE_FEED_HOSTS=rsshub
# Limite de tráfego do proxy de imagens ao buscar no site de origem (MB por minuto, GB por dia); acima disso, imagens sem cache respondem 503; vazio segue DEPLOYMENT.imageUpstreamBudget em site/site.ts, que por padrão não tem limite:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# Com um proxy reverso como Caddy ou Nginx à frente, use true para que o endereço do visitante seja lido do X-Forwarded-For do proxy;
# com o site exposto diretamente, mantenha false, para que ninguém forje endereços e contorne os limites de login e feedback.
TRUST_PROXY=false
# O MCP só aceita requisições para o domínio de SITE_URL (e localhost); se houver outros domínios de acesso, liste-os aqui separados por vírgula:
# MCP_ALLOWED_HOSTS=
# Minutos sem conteúdo novo até o site ser considerado "parou de coletar" e gerar alerta; vazio segue ALERTS.quietMinutes em site/site.ts (padrão 360):
# ALERT_QUIET_MINUTES=360
# Envia as páginas novas ao IndexNow (Bing e outros) todo dia; a chave tem 32 caracteres hexadecimais, gere uma você mesmo:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Backup diário do banco em armazenamento de objetos compatível com S3 (Tencent COS, AWS S3, Alibaba OSS...).
# Sem DB_BACKUP_STORE_DOMAIN, o endereço segue o formato do Tencent COS (<bucket>.cos.<região>.myqcloud.com);
# com outro provedor, informe o domínio de acesso com o nome do bucket, por exemplo AWS S3: my-bucket.s3.us-east-1.amazonaws.com:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Nível de log (padrão info) e limite do pool de conexões do banco (padrão 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Nome da versão: aparece na página "Execução" da administração e em /api/health, para confirmar que o processo foi renovado após a atualização:
# AIHOT_RELEASE=
# Nome do ambiente; por padrão, production ou development conforme NODE_ENV; fora de production os alertas o incluem, e o acesso sem login em desenvolvimento só vale fora de production:
# AIHOT_ENVIRONMENT=
# Guarda as chaves em grupos dentro de um diretório (models.env, collectors.env, integrations.env, auth.env), no lugar de escrevê-las aqui; o que estiver aqui tem prioridade:
# AIHOT_CREDENTIALS_DIR=

# ===== Válvulas de segurança =====
# Só com true o portal coleta fontes (inclusive os ícones diários das fontes) e chama modelos; remova as duas linhas ou use false para parar tudo (útil ao depurar a interface).
# Todas as chaves *_ENABLED deste arquivo só aceitam true; 1, yes ou TRUE valem como desligado.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Só necessário para rodar direto na máquina, sem Docker =====
# DATABASE_URL=postgres://usuario@127.0.0.1:5432/destaques
# API_BASE_URL=http://127.0.0.1:3001
# Diretório de arquivos enviados, cache de imagens e backups locais (padrão: .data dentro do repositório):
# AIHOT_DATA_DIR=/var/lib/destaques
# Entrar na administração sem login em desenvolvimento (em produção a inicialização é recusada) e o nome exibido:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Permitir coletar de endereços da rede interna ao depurar localmente (proibido por padrão; em produção a inicialização é recusada):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== Ao usar docker compose --profile https =====
# SITE_DOMAIN=example.com
# Porta aberta na máquina para o site (usada pelo docker compose; padrão 3000, acessível por todas as interfaces); com HTTPS, só para o Caddy local, sem exposição direta:
# PORT=127.0.0.1:3000
# Mude também o TRUST_PROXY acima para true.
